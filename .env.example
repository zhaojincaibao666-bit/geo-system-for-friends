# Local-only access token. Use a long random value and keep it out of Git.
AGENT_TOKEN=replace-with-a-long-random-value
PORT=4318

# Optional account details used only by local publishing integrations.
# GEO_PUBLISH_COMPANY_NAME=Your organization name
# GEO_PUBLISH_ACCOUNT=Your platform account identifier

# Web monitoring settings. Local browser profiles and debug captures stay under data/.
# DOUBAO_URL=https://www.doubao.com/chat/
# DOUBAO_PROFILE_PATH=data/doubao-profile
# DOUBAO_DEBUG_PATH=data/doubao-debug
# DOUBAO_CONCURRENCY=4
# MAX_RETRIES=2
# ANSWER_START_TIMEOUT=30000
# ANSWER_COMPLETE_TIMEOUT=120000
# TEXT_STABLE_MS=1800
# DOUBAO_TYPING_DELAY=25
# DOUBAO_RETRY_RECOVERY_COOLDOWN=5000
# DOUBAO_PLATFORM_UNAVAILABLE_THRESHOLD=3
# GEO_DIAGNOSTIC_BASELINE_RUNS=5
# GEO_DROP_ABSOLUTE_THRESHOLD=0.10
# GEO_DROP_RELATIVE_THRESHOLD=0.25
# DOUBAO_DEBUG_MODE=false
# DOUBAO_DEBUG_TRACE=false
